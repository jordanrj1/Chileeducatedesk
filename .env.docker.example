# Configuración de FCHE con Docker. levantar.sh / levantar.bat copian este archivo a .env.docker
# la primera vez y generan SECRET_KEY y DB_PASSWORD al azar. No subas .env.docker a GitHub.

# --- Seguridad (se generan solas la primera vez) ---
SECRET_KEY=cambia-esto
DB_PASSWORD=cambia-esto

# --- Base de datos (dentro de Docker; normalmente no se cambia) ---
DB_NAME=fche
DB_USER=fche

# --- Acceso ---
# 127.0.0.1 = solo este equipo (recomendado). 0.0.0.0 = también otros equipos de la red local.
ACCESO=127.0.0.1
PUERTO=8000
# Nombres o IP con que se entra al sistema, separados por coma (agrega la IP del equipo si abres a la red).
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DEBUG=False

# --- Funcionamiento (mismos ajustes que .env.example) ---
SESION_SEGUNDOS=3600
CONN_MAX_AGE=60
HILOS=8
DATOS_SENSIBLES=True
SEGUNDA_FASE=False
CONTACTO_ADMINISTRADOR=
LIMITE_ENVIOS_MINUTO=60
LIMITE_BUSQUEDAS_MINUTO=120
LIMITE_EXPORTACIONES_MINUTO=10
