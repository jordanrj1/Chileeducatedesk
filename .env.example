# Copiar a .env y completar. Nunca subir .env al repositorio.
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DEBUG=False
# Solo este equipo por defecto. Para la red de la Fundación [V#5], agregar su IP/nombre.
ALLOWED_HOSTS=127.0.0.1,localhost
DB_NAME=fche
DB_USER=fche
DB_PASSWORD=cambiar
DB_HOST=127.0.0.1
DB_PORT=5432
# Expiración de sesión por inactividad (segundos) [P]
SESION_SEGUNDOS=3600
# Muestra los módulos de segunda fase (reuniones, tareas, sesiones, beneficiarios, verificaciones, finanzas)
SEGUNDA_FASE=False
# Carpeta de archivos subidos, fuera del código
# MEDIA_ROOT=C:\fche_media   (Windows)  /  /Users/usuario/fche_media   (Mac)
# Carpeta de respaldos
# RESPALDO_DIR=C:\fche_respaldos
# Orígenes permitidos para formularios cuando se entra desde otros equipos [V#5]
# CSRF_TRUSTED_ORIGINS=http://192.168.1.10:8000
# Ruta de pg_dump si no está en el PATH
# PG_DUMP=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
