<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Nivel4" targetNamespace="http://fundacionchileeducate.cl/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.29.0">
  <collaboration id="Collab_N4">
    <participant id="Pool_N4_F" name="Fundación / gestión de información" processRef="Proc_N4" />
    <participant id="Pool_N4_A" name="Persona registrada" processRef="Proc_N4_A" />
    <messageFlow id="N4_M1" name="Datos para registro" sourceRef="A_Entregar" targetRef="N4_RegistrarPersona" />
    <messageFlow id="N4_M2" name="Acceso, si corresponde" sourceRef="N4_CrearCuenta" targetRef="A_Acceso" />
  </collaboration>
  <process id="Proc_N4" name="Gestión de personas y cuentas" isExecutable="false">
    <laneSet id="LS4">
      <lane id="N4_L">
        <flowNodeRef>N4_Start</flowNodeRef>
        <flowNodeRef>N4_BuscarPersona</flowNodeRef>
        <flowNodeRef>N4_G1</flowNodeRef>
        <flowNodeRef>N4_G2</flowNodeRef>
        <flowNodeRef>N4_CrearCuenta</flowNodeRef>
        <flowNodeRef>N4_SoloRegistro</flowNodeRef>
        <flowNodeRef>N4_End</flowNodeRef>
        <flowNodeRef>N4_RegistrarPersona</flowNodeRef>
        <flowNodeRef>N4_Relacionar</flowNodeRef>
        <flowNodeRef>N4_Historial</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="N4_Start" name="Se identifica una persona" />
    <task id="N4_BuscarPersona" name="Buscar registro existente" />
    <exclusiveGateway id="N4_G1" name="¿La persona ya existe?" />
    <exclusiveGateway id="N4_G2" name="¿Necesita acceder al sistema?" />
    <task id="N4_CrearCuenta" name="Crear cuenta y asignar rol" />
    <task id="N4_SoloRegistro" name="Mantener como registro sin cuenta" />
    <endEvent id="N4_End" name="Persona disponible para futuras relaciones" />
    <task id="N4_RegistrarPersona" name="Crear o actualizar ficha de persona" />
    <task id="N4_Relacionar" name="Relacionar con institución, organización o actividad" />
    <task id="N4_Historial" name="Conservar trayectoria e historial" />
    <sequenceFlow id="p1" sourceRef="N4_Start" targetRef="N4_BuscarPersona" />
    <sequenceFlow id="p2" sourceRef="N4_BuscarPersona" targetRef="N4_G1" />
    <sequenceFlow id="p3" name="No" sourceRef="N4_G1" targetRef="N4_RegistrarPersona" />
    <sequenceFlow id="p4" name="Sí" sourceRef="N4_G1" targetRef="N4_Relacionar" />
    <sequenceFlow id="p6" sourceRef="N4_Relacionar" targetRef="N4_G2" />
    <sequenceFlow id="p7" name="Sí" sourceRef="N4_G2" targetRef="N4_CrearCuenta" />
    <sequenceFlow id="p8" name="No" sourceRef="N4_G2" targetRef="N4_SoloRegistro" />
    <sequenceFlow id="p9" sourceRef="N4_CrearCuenta" targetRef="N4_Historial" />
    <sequenceFlow id="p10" sourceRef="N4_SoloRegistro" targetRef="N4_Historial" />
    <sequenceFlow id="p11" sourceRef="N4_Historial" targetRef="N4_End" />
  </process>
  <process id="Proc_N4_A" name="Entrega de datos / acceso" isExecutable="false">
    <startEvent id="A_Start" name="Persona identificada" />
    <task id="A_Entregar" name="Entregar datos o antecedentes" />
    <task id="A_Acceso" name="Ingresar al sistema si tiene cuenta" />
    <endEvent id="A_End" name="Interacción completada" />
    <sequenceFlow id="q1" sourceRef="A_Start" targetRef="A_Entregar" />
    <sequenceFlow id="q2" sourceRef="A_Entregar" targetRef="A_Acceso" />
    <sequenceFlow id="q3" sourceRef="A_Acceso" targetRef="A_End" />
  </process>
  <dataStore id="DS_N4_P" name="Banco de personas" />
  <dataStore id="DS_N4_U" name="Cuentas y roles" />
  <dataStore id="DS_N4_H" name="Historial de participaciones" />
