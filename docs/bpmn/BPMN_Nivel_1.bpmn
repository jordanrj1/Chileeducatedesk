<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Nivel1" targetNamespace="http://fundacionchileeducate.cl/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.29.0">
  <message id="M1" name="Solicitud o necesidad" />
  <message id="M2" name="Antecedentes faltantes" />
  <message id="M3" name="Convocatoria y disponibilidad" />
  <message id="M4" name="Confirmación de actividad" />
  <message id="M5" name="Resultado de actividad" />
  <collaboration id="Collab_N1">
    <participant id="Pool_Origen" name="Institución / organización / comunidad / persona" processRef="Proc_Origen" />
    <participant id="Pool_Fundacion" name="Fundación Chile Edúcate" processRef="Proc_Fundacion" />
    <participant id="Pool_Part" name="Personas convocadas / participantes" processRef="Proc_Part" />
    <messageFlow id="MF1" name="Solicitud o necesidad" sourceRef="O_Contactar" targetRef="F_InicioExt" />
    <messageFlow id="MF2" name="Antecedentes faltantes" sourceRef="F_SolicitarDatos" targetRef="O_EntregarDatos" />
    <messageFlow id="MF3" name="Convocatoria" sourceRef="F_Convocar" targetRef="P_Recibir" />
    <messageFlow id="MF4" name="Interés / disponibilidad" sourceRef="P_Responder" targetRef="F_Convocar" />
    <messageFlow id="MF5" name="Confirmación" sourceRef="F_Confirmar" targetRef="O_RecibirConfirmacion" />
    <messageFlow id="MF6" name="Resultado / observaciones" sourceRef="P_Result" targetRef="F_Cerrar" />
    <textAnnotation id="N1_Entradas">
      <text>ENTRADAS
• Solicitud o necesidad externa
• Oportunidad detectada mediante búsqueda activa</text>
    </textAnnotation>
    <textAnnotation id="N1_Regla">
      <text>REGLA DE DISEÑO
Una persona puede participar sin tener cuenta.
La cuenta se crea solo si necesita ingresar y ejecutar acciones.</text>
    </textAnnotation>
    <textAnnotation id="N1_Salida">
      <text>SALIDAS
• Actividad ejecutada o no concretada
• Agenda actualizada
• Participantes y organizaciones relacionadas
• Resultado e historial</text>
    </textAnnotation>
  </collaboration>
  <process id="Proc_Origen" name="Interacción externa" isExecutable="false">
    <task id="O_Contactar" name="Contactar a la Fundación" />
    <task id="O_RecibirConfirmacion" name="Recibir confirmación y datos operativos" />
    <startEvent id="O_Start" name="Surge una necesidad o propuesta" />
    <task id="O_EntregarDatos" name="Entregar o completar antecedentes" />
    <endEvent id="O_End" name="Coordinación informada" />
    <sequenceFlow id="O1" sourceRef="O_Start" targetRef="O_Contactar" />
    <sequenceFlow id="O2" sourceRef="O_Contactar" targetRef="O_EntregarDatos" />
    <sequenceFlow id="O3" sourceRef="O_EntregarDatos" targetRef="O_RecibirConfirmacion" />
    <sequenceFlow id="O4" sourceRef="O_RecibirConfirmacion" targetRef="O_End" />
  </process>
  <process id="Proc_Part" name="Participación" isExecutable="false">
    <startEvent id="P_Start" name="Convocatoria recibida" />
    <task id="P_Recibir" name="Recibir información" />
    <task id="P_Responder" name="Informar interés y disponibilidad" />
    <task id="P_Participar" name="Participar en la actividad" />
    <task id="P_Result" name="Informar asistencia u observaciones" />
    <endEvent id="P_End" name="Participación finalizada" />
    <sequenceFlow id="P1" sourceRef="P_Start" targetRef="P_Recibir" />
    <sequenceFlow id="P2" sourceRef="P_Recibir" targetRef="P_Responder" />
    <sequenceFlow id="P3" sourceRef="P_Responder" targetRef="P_Participar" />
    <sequenceFlow id="P4" sourceRef="P_Participar" targetRef="P_Result" />
    <sequenceFlow id="P5" sourceRef="P_Result" targetRef="P_End" />
  </process>
  <process id="Proc_Fundacion" name="Proceso principal - Fundación Chile Edúcate" isExecutable="false">
    <laneSet id="LS1">
      <lane id="Lane_Plataforma" name="Plataforma y trazabilidad">
        <flowNodeRef>F_Buscar</flowNodeRef>
      </lane>
      <lane id="Lane_Coord" name="Coordinación y gestión">
        <flowNodeRef>F_Valida</flowNodeRef>
        <flowNodeRef>F_InicioActivo</flowNodeRef>
        <flowNodeRef>F_Registrar</flowNodeRef>
        <flowNodeRef>F_InicioExt</flowNodeRef>
        <flowNodeRef>F_Info</flowNodeRef>
        <flowNodeRef>F_SolicitarDatos</flowNodeRef>
        <flowNodeRef>F_Definir</flowNodeRef>
        <flowNodeRef>F_Convocar</flowNodeRef>
        <flowNodeRef>F_Coordinar</flowNodeRef>
        <flowNodeRef>F_Confirmar</flowNodeRef>
        <flowNodeRef>F_Recoordinar</flowNodeRef>
        <flowNodeRef>F_Ejecutar</flowNodeRef>
        <flowNodeRef>F_Cambio</flowNodeRef>
        <flowNodeRef>F_Fin</flowNodeRef>
        <flowNodeRef>F_Cerrar</flowNodeRef>
      </lane>
    </laneSet>
    <exclusiveGateway id="F_Valida" name="¿Se cumplen las condiciones?" />
    <startEvent id="F_InicioActivo" name="Entrada interna: búsqueda activa" />
    <task id="F_Registrar" name="Registrar y clasificar oportunidad" />
    <startEvent id="F_InicioExt" name="Entrada externa: solicitud / necesidad" />
    <exclusiveGateway id="F_Info" name="¿Información mínima disponible?" />
    <task id="F_SolicitarDatos" name="Solicitar antecedentes faltantes" />
    <task id="F_Buscar" name="Buscar candidatos y recursos" />
    <task id="F_Definir" name="Definir actividad, objetivo y condiciones" />
    <task id="F_Convocar" name="Contactar y registrar disponibilidad" />
    <task id="F_Coordinar" name="Coordinar participantes, lugar y fecha" />
    <task id="F_Confirmar" name="Confirmar y comunicar actividad" />
    <task id="F_Recoordinar" name="Recoordinar actividad" />
    <task id="F_Ejecutar" name="Ejecutar actividad" />
    <exclusiveGateway id="F_Cambio" name="¿Existe cambio o interrupción?" />
    <endEvent id="F_Fin" name="Actividad cerrada / historial actualizado" />
    <task id="F_Cerrar" name="Registrar resultado y cerrar" />
    <sequenceFlow id="F10" sourceRef="F_Coordinar" targetRef="F_Valida" />
    <sequenceFlow id="F11" name="No" sourceRef="F_Valida" targetRef="F_Recoordinar" />
    <sequenceFlow id="F13" name="Sí" sourceRef="F_Valida" targetRef="F_Confirmar" />
    <sequenceFlow id="F2" sourceRef="F_InicioActivo" targetRef="F_Registrar" />
    <sequenceFlow id="F1" sourceRef="F_InicioExt" targetRef="F_Registrar" />
    <sequenceFlow id="F3" sourceRef="F_Registrar" targetRef="F_Info" />
    <sequenceFlow id="F5" name="Antecedentes recibidos" sourceRef="F_SolicitarDatos" targetRef="F_Info" />
    <sequenceFlow id="F4" name="No" sourceRef="F_Info" targetRef="F_SolicitarDatos" />
    <sequenceFlow id="F6" name="Sí" sourceRef="F_Info" targetRef="F_Definir" />
    <sequenceFlow id="F7" sourceRef="F_Definir" targetRef="F_Buscar" />
    <sequenceFlow id="F8" sourceRef="F_Buscar" targetRef="F_Convocar" />
    <sequenceFlow id="F9" sourceRef="F_Convocar" targetRef="F_Coordinar" />
    <sequenceFlow id="F12" name="Nueva propuesta" sourceRef="F_Recoordinar" targetRef="F_Coordinar" />
    <sequenceFlow id="F14" sourceRef="F_Confirmar" targetRef="F_Cambio" />
    <sequenceFlow id="F15" name="Sí" sourceRef="F_Cambio" targetRef="F_Recoordinar" />
    <sequenceFlow id="F16" name="No" sourceRef="F_Cambio" targetRef="F_Ejecutar" />
    <sequenceFlow id="F17" sourceRef="F_Ejecutar" targetRef="F_Cerrar" />
    <sequenceFlow id="F18" sourceRef="F_Cerrar" targetRef="F_Fin" />
  </process>
  <dataStore id="D_Personas" name="Banco de personas" />
  <dataStore id="D_Organ" name="Banco de organizaciones e instituciones" />
  <dataStore id="D_Lugares" name="Banco de lugares" />
  <dataStore id="D_Hist" name="Historial de actividades" />
