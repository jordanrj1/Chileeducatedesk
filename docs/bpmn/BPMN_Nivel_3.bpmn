<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Nivel3" targetNamespace="http://fundacionchileeducate.cl/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.29.0">
  <collaboration id="Collab_N3">
    <participant id="Pool_N3_F" name="Fundación" processRef="Proc_N3" />
    <participant id="Pool_N3_E" name="Participantes / organizaciones" processRef="Proc_N3_E" />
    <messageFlow id="N3_M1" name="Programación confirmada" sourceRef="N3_Comunicar" targetRef="E_Recibir" />
    <messageFlow id="N3_M2" name="Cambio / novedad" sourceRef="E_Cambio" targetRef="N3_RegistrarCambio" />
  </collaboration>
  <process id="Proc_N3" name="Agenda y ejecución" isExecutable="false">
    <laneSet id="LS3">
      <lane id="N3_L">
        <flowNodeRef>N3_Start</flowNodeRef>
        <flowNodeRef>N3_Agendar</flowNodeRef>
        <flowNodeRef>N3_Comunicar</flowNodeRef>
        <flowNodeRef>N3_G</flowNodeRef>
        <flowNodeRef>N3_Ejecutar</flowNodeRef>
        <flowNodeRef>N3_Cerrar</flowNodeRef>
        <flowNodeRef>N3_RegistrarCambio</flowNodeRef>
        <flowNodeRef>N3_Actualizar</flowNodeRef>
        <flowNodeRef>N3_End</flowNodeRef>
        <flowNodeRef>N3_Validar</flowNodeRef>
        <flowNodeRef>N3_Recoordinar</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="N3_Start" name="Actividad confirmada" />
    <task id="N3_Agendar" name="Registrar evento en agenda" />
    <task id="N3_Comunicar" name="Comunicar programación" />
    <exclusiveGateway id="N3_G" name="¿Existe cambio o interrupción?" />
    <task id="N3_Ejecutar" name="Ejecutar actividad" />
    <task id="N3_Cerrar" name="Registrar asistencia, resultados y evidencias" />
    <task id="N3_RegistrarCambio" name="Registrar cambio y motivo" />
    <task id="N3_Actualizar" name="Actualizar agenda y conservar versión anterior" />
    <endEvent id="N3_End" name="Actividad cerrada" />
    <task id="N3_Validar" name="Validar nuevamente" />
    <task id="N3_Recoordinar" name="Recoordinar fecha, lugar o participantes" />
    <sequenceFlow id="a1" sourceRef="N3_Start" targetRef="N3_Agendar" />
    <sequenceFlow id="a2" sourceRef="N3_Agendar" targetRef="N3_Comunicar" />
    <sequenceFlow id="a9" name="Nueva programación" sourceRef="N3_Actualizar" targetRef="N3_Comunicar" />
    <sequenceFlow id="a3" sourceRef="N3_Comunicar" targetRef="N3_G" />
    <sequenceFlow id="a4" name="Sí" sourceRef="N3_G" targetRef="N3_RegistrarCambio" />
    <sequenceFlow id="a8" name="No" sourceRef="N3_G" targetRef="N3_Ejecutar" />
    <sequenceFlow id="a10" sourceRef="N3_Ejecutar" targetRef="N3_Cerrar" />
    <sequenceFlow id="a11" sourceRef="N3_Cerrar" targetRef="N3_End" />
    <sequenceFlow id="a5" sourceRef="N3_RegistrarCambio" targetRef="N3_Recoordinar" />
    <sequenceFlow id="a12" name="Compatibilidad confirmada" sourceRef="N3_Validar" targetRef="N3_Actualizar" />
    <sequenceFlow id="a6" sourceRef="N3_Recoordinar" targetRef="N3_Validar" />
  </process>
  <process id="Proc_N3_E" name="Participantes y organizaciones" isExecutable="false">
    <startEvent id="E_Start" name="Información recibida" />
    <task id="E_Recibir" name="Recibir programación" />
    <task id="E_Cambio" name="Informar cambio o novedad" />
    <endEvent id="E_End" name="Coordinación actualizada" />
    <sequenceFlow id="e1" sourceRef="E_Start" targetRef="E_Recibir" />
    <sequenceFlow id="e2" sourceRef="E_Recibir" targetRef="E_Cambio" />
    <sequenceFlow id="e3" sourceRef="E_Cambio" targetRef="E_End" />
  </process>
  <dataStore id="DS_Agenda" name="Agenda / versiones de eventos" />
  <dataStore id="DS_HistN3" name="Historial y evidencias" />
