<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Nivel2" targetNamespace="http://fundacionchileeducate.cl/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.29.0">
  <collaboration id="Collab_N2">
    <participant id="Pool_N2_F" name="Fundación - Coordinación" processRef="Proc_N2" />
    <participant id="Pool_N2_C" name="Persona / organización contactada" processRef="Proc_N2_C" />
    <messageFlow id="N2_M1" name="Consulta de disponibilidad" sourceRef="N2_Contactar" targetRef="C_Recibir" />
    <messageFlow id="N2_M2" name="Respuesta" sourceRef="C_Responder" targetRef="N2_Registrar" />
  </collaboration>
  <process id="Proc_N2" name="Coordinación y matching" isExecutable="false">
    <laneSet id="LS2">
      <lane id="N2_L">
        <flowNodeRef>N2_Start</flowNodeRef>
        <flowNodeRef>N2_DefinirCriterios</flowNodeRef>
        <flowNodeRef>N2_ConsultarBanco</flowNodeRef>
        <flowNodeRef>N2_Filtrar</flowNodeRef>
        <flowNodeRef>N2_Revisar</flowNodeRef>
        <flowNodeRef>N2_Contactar</flowNodeRef>
        <flowNodeRef>N2_Registrar</flowNodeRef>
        <flowNodeRef>N2_End</flowNodeRef>
        <flowNodeRef>N2_Seleccionar</flowNodeRef>
        <flowNodeRef>N2_G</flowNodeRef>
        <flowNodeRef>N2_Ajustar</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="N2_Start" name="Necesidad definida" />
    <task id="N2_DefinirCriterios" name="Definir criterios de búsqueda">
      <outgoing>n9</outgoing>
    </task>
    <task id="N2_ConsultarBanco" name="Consultar banco de información" />
    <task id="N2_Filtrar" name="Aplicar filtros de zona, área, tipo, disponibilidad y origen" />
    <task id="N2_Revisar" name="Revisar candidatos y recursos" />
    <task id="N2_Contactar" name="Contactar candidatos y registrar respuesta" />
    <task id="N2_Registrar" name="Registrar interés, disponibilidad y rol" />
    <dataStoreReference id="N2_DSR_P" name="Banco de Personas" dataStoreRef="DS_P" />
    <dataStoreReference id="N2_DSR_O" name="Banco de Organizaciones" dataStoreRef="DS_O" />
    <dataStoreReference id="N2_DSR_L" name="Banco de Lugares" dataStoreRef="DS_L" />
    <endEvent id="N2_End" name="Candidatos coordinados" />
    <task id="N2_Seleccionar" name="Seleccionar participantes y recursos" />
    <exclusiveGateway id="N2_G" name="¿Hay combinación suficiente?" />
    <task id="N2_Ajustar" name="Ajustar criterios o buscar nuevas opciones">
      <incoming>n9</incoming>
    </task>
    <sequenceFlow id="n1" sourceRef="N2_Start" targetRef="N2_DefinirCriterios" />
    <sequenceFlow id="n2" sourceRef="N2_DefinirCriterios" targetRef="N2_ConsultarBanco" />
    <sequenceFlow id="n9" name="Nuevo intento" sourceRef="N2_DefinirCriterios" targetRef="N2_Ajustar" />
    <sequenceFlow id="n3" sourceRef="N2_ConsultarBanco" targetRef="N2_Filtrar" />
    <sequenceFlow id="n4" sourceRef="N2_Filtrar" targetRef="N2_Revisar" />
    <sequenceFlow id="n5" sourceRef="N2_Revisar" targetRef="N2_Contactar" />
    <sequenceFlow id="n6" sourceRef="N2_Contactar" targetRef="N2_Registrar" />
    <sequenceFlow id="n7" sourceRef="N2_Registrar" targetRef="N2_G" />
    <sequenceFlow id="n11" sourceRef="N2_Seleccionar" targetRef="N2_End" />
    <sequenceFlow id="n10" name="Sí" sourceRef="N2_G" targetRef="N2_Seleccionar" />
    <sequenceFlow id="n8" name="No" sourceRef="N2_G" targetRef="N2_Ajustar" />
  </process>
  <process id="Proc_N2_C" name="Respuesta externa" isExecutable="false">
    <startEvent id="C_Start" name="Solicitud recibida" />
    <task id="C_Recibir" name="Recibir consulta" />
    <task id="C_Responder" name="Informar interés y disponibilidad" />
    <endEvent id="C_End" name="Respuesta enviada" />
    <sequenceFlow id="c1" sourceRef="C_Start" targetRef="C_Recibir" />
    <sequenceFlow id="c2" sourceRef="C_Recibir" targetRef="C_Responder" />
    <sequenceFlow id="c3" sourceRef="C_Responder" targetRef="C_End" />
  </process>
  <dataStore id="DS_P" name="Banco de Personas" />
  <dataStore id="DS_O" name="Banco de Organizaciones" />
  <dataStore id="DS_L" name="Banco de Lugares" />
